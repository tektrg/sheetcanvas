{
  "name": "SheetCanvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "tmux:capture": "node scripts/tmux-run-capture.mjs",
    "agent:eval": "node scripts/agent-eval.mjs",
    "build": "vite build",
    "seo:gsc": "node scripts/search-console-report.mjs",
    "seo:gsc:smoke": "node scripts/search-console-report-smoke.mjs",
    "seo:root:analytics:smoke": "node scripts/seo-root-analytics-smoke.mjs",
    "seo:analytics:smoke": "node scripts/seo-support-analytics-smoke.mjs",
    "seo:deploy:smoke": "node scripts/seo-deploy-preflight-smoke.mjs",
    "seo:live:root": "node scripts/seo-live-root-check.mjs",
    "seo:live:support": "node scripts/seo-live-support-check.mjs",
    "seo:llms": "node scripts/generate-llms.mjs",
    "seo:rss": "node scripts/generate-rss.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "npm run seo:sitemap && npm run seo:rss && npm run seo:llms && npm run seo:gsc:smoke && npm run seo:root:analytics:smoke && npm run seo:analytics:smoke && npm run seo:deploy:smoke && npm run build && node scripts/seo-audit.mjs",
    "deploy:pages": "npm run seo:audit && node scripts/seo-deploy-preflight.mjs && wrangler pages deploy dist --project-name sheetcanvas --branch main && npm run seo:live:root -- --retries 6 --retry-delay-ms 10000 && npm run seo:live:support -- --retries 6 --retry-delay-ms 10000",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/react": "^3.0.193",
    "@tanstack/react-virtual": "3.5.0",
    "ai": "^6.0.191",
    "alasql": "^4.17.3",
    "d3-format": "3.1.0",
    "html2canvas": "1.4.1",
    "idb": "8.0.0",
    "lucide-react": "^0.554.0",
    "markdown-to-jsx": "^9.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "2.15.0",
    "xlsx": "0.18.5",
    "zod": "^4.4.3",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.73.0"
  }
}
